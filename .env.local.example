# Copia este archivo a .env.local y rellena con tus claves reales.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
# Service role: SOLO servidor, la usa el webhook para marcar Pro. NO la expongas.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
# Secreto del webhook (lo da Stripe al crear el endpoint o `stripe listen`).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Spotify (PKCE, solo cliente) ---
# Crea una app en https://developer.spotify.com/dashboard y añade el Redirect URI:
#   <tu-dominio>/spotify-callback  (y http://localhost:3000/spotify-callback)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=tu_client_id
